# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Base URL used when building SIWS messages and links.
APP_ORIGIN=http://localhost:8787

# Where the SQLite ledger and the generated Solana keypairs live. Both default to
# paths inside the project, which is right locally. On a container host a relative
# path sits in the deploy directory and is commonly replaced on redeploy — which
# takes every case, ruling and the platform wallet with it — so point both at a
# mounted volume there:
#   DATA_DIR=/data
#   KEYS_DIR=/data/keys
DATA_DIR=data
KEYS_DIR=keys

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production (NODE_ENV=production refuses to boot without them)
# ---------------------------------------------------------------------------
# Signing key for session JWTs. Must be random and at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Gates POST /auth/admin-signup. If unset in production, admin signup is disabled.
ADMIN_SETUP_SECRET=

# Authorises creating a support or dev account. Those two roles open the operator
# console and the case docket, so they are not self-service: a caller presents this
# code in the x-staff-invite header. Leave it unset and production refuses staff
# signup outright, which also means nobody can reach the console. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
STAFF_INVITE_CODE=

# ---------------------------------------------------------------------------
# Authentication policy
# ---------------------------------------------------------------------------
# Require a verified email address before login succeeds.
REQUIRE_EMAIL_VERIFICATION=false
# Lifetime of the JWT access token (ms-style strings like 12h, 30m, 7d).
ACCESS_TOKEN_TTL=12h
# Lifetime of email-verification / password-reset tokens, in minutes.
AUTH_TOKEN_TTL_MINUTES=60
# Lock an identifier after N failed logins for M minutes.
LOCKOUT_THRESHOLD=8
LOCKOUT_MINUTES=15
# Comma-separated cross-origin allow-list (leave empty for same-origin only).
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Hosted sign-in (Auth0 / OIDC) — optional
# ---------------------------------------------------------------------------
# Create a *Regular Web Application* in Auth0 (not an API). Leave these blank and
# the login page stays on local email/password + demo personas; fill in all three
# and it switches to Auth0 Universal Login and shows the "AUTH0 · READY" badge.
#
# The tenant also needs three URLs whitelisted under the application's Settings —
# the login page prints the exact values it expects when they are missing. On a
# deployment those URLs are the public origin, not localhost, and Auth0 only
# answers a callback the tenant has been told about:
#   Allowed Callback URLs  https://your-app.example/callback
#   Allowed Logout URLs    https://your-app.example/login
#   Allowed Web Origins    https://your-app.example
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
# Auth0 dashboard → Applications → your app → Settings → Client Secret.
AUTH0_CLIENT_SECRET=
# The redirect URI Auth0 sends the authorization code back to. It must match an
# entry in the application's Allowed Callback URLs, and the callback route is
# registered at this path — point it at whatever your tenant whitelists.
# (Auth0's own Express quickstart whitelists http://localhost:8787/callback,
# which is why that is the default here rather than /auth/auth0/callback.)
AUTH0_CALLBACK_URL=http://localhost:8787/callback
# Where the browser lands after Auth0's federated logout. Add it to the
# application's Allowed Logout URLs, or Auth0 silently ignores the returnTo.
AUTH0_LOGOUT_RETURN_TO=http://localhost:8787/login

# ---------------------------------------------------------------------------
# Demo / development affordances
# ---------------------------------------------------------------------------
# Return the generated per-user Solana signing keypair in API responses, and let
# /demo/actors hand out the seeded wallets' keys. Defaults to false when
# NODE_ENV=production.
EXPOSE_DEMO_SECRET_KEYS=
# Seed the demo accounts on boot (credentials buyer/buyer123, seller/seller123,
# admin/admin123 — the UI labels them Client, Freelancer and Operator). Off in
# production by default, but a hosted demo usually wants it on so that a staff
# account exists to open the operator console with. Those passwords are published
# in this repository, so anyone who has read it can sign in as staff.
SEED_DEMO_ACCOUNTS=
# Top a buyer wallet up from the platform wallet whenever a deposit is short.
# Off in production: a real deployment must not fund users from the platform
# balance. A demo on devnet normally turns it back on.
AUTO_FUND_BUYER_WALLET=

# NOTE: the /demo/* helpers (seeded wallets, airdrop, sign-transfer, fast-forward)
# are registered in development only. With NODE_ENV=production they answer 404, so
# the one-click personas on the login page are unavailable there by design — sign
# in with the seeded credentials above instead.

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------
CHAIN=devnet
# Solana RPC (defaults to https://api.devnet.solana.com when unset)
SOLANA_RPC_URL=

# Platform escrow authority keypair (base58 secret key). Generated at keys/platform.json if unset.
PLATFORM_KEY_B58=

# Arbiter keypair for dispute rulings (base58). Generated if unset.
ARBITER_KEY_B58=

# Neon Postgres mirror (optional; the app runs on SQLite if unreachable)
DATABASE_URL=

# Gemini (public ticker needs no key; set these only to enable private fiat payout flow)
GEMINI_API_KEY=
GEMINI_API_SECRET=

# ---------------------------------------------------------------------------
# LLM — the model behind the case engine (server/llm.ts)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint works. With no key set the
# engine reports itself unavailable and falls back to a previously cached
# response for the same input; it never invents one. Point LLM_BASE_URL at a
# locally hosted server to run a case with no internet at all.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Hard ceiling on a single call, in milliseconds. A hung provider must not hold
# a ruling (or a demo) hostage.
LLM_TIMEOUT_MS=20000

# Optional: AirdropCo for reliable devnet SOL when the public faucet rate-limits
AIRDROP_URL=
