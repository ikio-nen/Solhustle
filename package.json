{
  "name": "solhustle",
  "version": "1.0.0",
  "description": "Solhustle — Solana Escrow Freelance Marketplace",
  "type": "module",
  "scripts": {
    "start": "node --dns-result-order=ipv4first --experimental-strip-types --experimental-transform-types --env-file-if-exists=.env src/server.ts",
    "dev": "node --dns-result-order=ipv4first --experimental-strip-types --experimental-transform-types --env-file-if-exists=.env --watch src/server.ts",
    "seed": "node --dns-result-order=ipv4first --experimental-strip-types --experimental-transform-types --env-file-if-exists=.env src/seed.ts",
    "demo-story": "node --dns-result-order=ipv4first --experimental-strip-types --experimental-transform-types --env-file-if-exists=.env src/demo-story.ts",
    "test": "node --dns-result-order=ipv4first --experimental-strip-types --experimental-transform-types --env-file-if-exists=.env --test tests/e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.23.1",
    "bs58": "^6.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
